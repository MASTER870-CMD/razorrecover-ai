# ==============================================================================
# RAZORRECOVER AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development | test | production)
APP_ENV=development

# Payment Mode: 'simulator' (default, no credentials required) or 'razorpay' (test mode)
PAYMENT_MODE=simulator

# Razorpay Test Mode Credentials (Optional in simulator mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_token
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# AI Agent Configuration
# Optional: If not provided, the deterministic AI expert system fallback is used seamlessly
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database Connection
# Uses local SQLite if not configured or PostgreSQL for production/docker
DATABASE_URL=sqlite:///./razorrecover.db
# For PostgreSQL: postgresql+psycopg2://razor_user:razor_password@localhost:5432/razorrecover_ai

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Web Application Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_PAYMENT_MODE=simulator
